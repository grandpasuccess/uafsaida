// UAFSAIDA — Prisma Database Schema
// Full database schema for the platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════
// USER & AUTH
// ═══════════════════════════════════════════════════════════════

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  role          String    @default("user") // user, admin
  preferences   Json?     // UI preferences, mode (beginner/advanced)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  projects      Project[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model AuthSession {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════════════════════════════════════════
// PROJECT
// ═══════════════════════════════════════════════════════════════

model Project {
  id            String           @id @default(cuid())
  name          String
  description   String           @default("")
  status        String           @default("draft")
  complexity    String           @default("moderate")
  type          String           @default("webapp")
  prompt        String           @default("")
  repoUrl       String?
  deployUrl     String?
  isPublic      Boolean          @default(false)
  metadata      Json?            // flexible metadata
  
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  requirements  Json?            // ProjectRequirement
  architecture  Json?            // ArchitectureDecision
  techStack     Json?            // TechStack
  memory        Json?            // ProjectMemory
  
  files         ProjectFile[]
  sessions      AgentSession[]
  deployments   Deployment[]
  versions      ProjectVersion[]
  
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([userId])
  @@index([status])
}

// ═══════════════════════════════════════════════════════════════
// FILES
// ═══════════════════════════════════════════════════════════════

model ProjectFile {
  id            String    @id @default(cuid())
  path          String
  content       String    @default("")
  language      String    @default("typescript")
  size          Int       @default(0)
  isGenerated   Boolean   @default(true)
  isModified    Boolean   @default(false)
  generatedBy   String?   // agent role
  version       Int       @default(1)
  
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([projectId, path])
  @@index([projectId])
}

// ═══════════════════════════════════════════════════════════════
// AGENT SESSIONS & MESSAGES
// ═══════════════════════════════════════════════════════════════

model AgentSession {
  id              String        @id @default(cuid())
  status          String        @default("active")
  currentPhase    String        @default("requirement-analysis")
  
  projectId       String
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  messages        ChatMessage[]
  tasks           AgentTask[]
  agents          AgentState[]
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([projectId])
  @@index([status])
}

model ChatMessage {
  id              String        @id @default(cuid())
  role            String        // user, assistant, system, agent
  agentRole       String?
  content         String        @db.Text
  metadata        Json?
  
  sessionId       String
  session         AgentSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  timestamp       DateTime      @default(now())

  @@index([sessionId])
  @@index([timestamp])
}

model AgentState {
  id              String        @id @default(cuid())
  role            String        // agent role
  name            String
  status          String        @default("idle")
  progress        Int           @default(0)
  currentTask     String?
  
  sessionId       String
  session         AgentSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([sessionId, role])
}

// ═══════════════════════════════════════════════════════════════
// TASKS & ARTIFACTS
// ═══════════════════════════════════════════════════════════════

model AgentTask {
  id              String        @id @default(cuid())
  title           String
  description     String        @default("")
  status          String        @default("pending")
  priority        String        @default("medium")
  agentRole       String
  dependencies    String[]      // task IDs
  estimatedDuration Int         @default(0)
  actualDuration  Int?
  
  sessionId       String
  session         AgentSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  artifacts       Artifact[]
  
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([sessionId])
  @@index([status])
  @@index([agentRole])
}

model Artifact {
  id              String        @id @default(cuid())
  type            String        // prd, architecture-doc, component, etc.
  name            String
  content         String        @db.Text
  metadata        Json?
  
  taskId          String
  task            AgentTask     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([taskId])
  @@index([type])
}

// ═══════════════════════════════════════════════════════════════
// DEBUGGING
// ═══════════════════════════════════════════════════════════════

model DebugSession {
  id              String        @id @default(cuid())
  status          String        @default("detecting")
  
  sessionId       String
  errors          DebugError[]
  fixes           DebugFix[]
  
  startTime       DateTime      @default(now())
  endTime         DateTime?

  @@index([sessionId])
}

model DebugError {
  id              String        @id @default(cuid())
  type            String
  severity        String
  message         String
  file            String?
  line            Int?
  column          Int?
  stackTrace      String?       @db.Text
  suggestedFix    String?       @db.Text
  resolved        Boolean       @default(false)
  resolvedAt      DateTime?
  
  debugSessionId  String
  debugSession    DebugSession  @relation(fields: [debugSessionId], references: [id], onDelete: Cascade)

  @@index([debugSessionId])
}

model DebugFix {
  id              String        @id @default(cuid())
  description     String
  filesChanged    String[]
  diff            String        @db.Text
  applied         Boolean       @default(false)
  validated       Boolean       @default(false)
  appliedAt       DateTime?
  
  debugSessionId  String
  debugSession    DebugSession  @relation(fields: [debugSessionId], references: [id], onDelete: Cascade)
  errorId         String?

  @@index([debugSessionId])
}

// ═══════════════════════════════════════════════════════════════
// DEPLOYMENT
// ═══════════════════════════════════════════════════════════════

model Deployment {
  id              String        @id @default(cuid())
  target          String        // local, docker, vercel, etc.
  environment     String        @default("development")
  domain          String?
  envVars         Json?
  buildCommand    String?
  outputDir       String?
  status          String        @default("pending")
  url             String?
  deployedAt      DateTime?
  
  projectId       String
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([projectId])
  @@index([status])
}

// ═══════════════════════════════════════════════════════════════
// VERSION CONTROL
// ═══════════════════════════════════════════════════════════════

model ProjectVersion {
  id              String        @id @default(cuid())
  commitHash      String?       @unique
  commitMessage   String
  changes         Json          // array of file changes
  snapshot        Json          // full file snapshot
  
  projectId       String
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  createdAt       DateTime      @default(now())

  @@index([projectId])
}

// ═══════════════════════════════════════════════════════════════
// QUALITY REPORTS
// ═══════════════════════════════════════════════════════════════

model QualityReport {
  id              String        @id @default(cuid())
  overallScore    Int           @default(0)
  gates           Json          // QualityGateResult[]
  summary         String        @default("")
  recommendations String[]      @default([])
  
  projectId       String
  createdAt       DateTime      @default(now())

  @@index([projectId])
}
